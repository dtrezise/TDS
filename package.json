{
  "name": "tds-evidence-archive",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "build": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "build:pages": "next build --webpack",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "test": "next build --webpack && node --test tests/*.test.mjs",
    "audit:research": "node scripts/audit-research.mjs",
    "audit:archive": "node scripts/archive-export.mjs --check",
    "audit:links": "node scripts/check-links.mjs",
    "audit:voices": "node scripts/check-voice-links.mjs",
    "audit:blind-eyes": "node scripts/check-blind-eyes-links.mjs",
    "audit:anti-christ": "node scripts/check-anti-christ-links.mjs",
    "audit:whats-new": "node scripts/sync-whats-new.mjs --check",
    "audit:experts": "node scripts/audit-expert-pipeline.mjs --require",
    "audit:public-boundary": "node scripts/check-public-boundary.mjs",
    "mobile:export": "node --import tsx scripts/export-mobile-data.ts",
    "whats-new:sync": "node scripts/sync-whats-new.mjs",
    "archive:export": "node scripts/archive-export.mjs --output outputs/archive-export-v1.json --sql-output outputs/archive-seed-v1.sql",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "verify": "node scripts/audit-research.mjs && node scripts/archive-export.mjs --check && node scripts/sync-whats-new.mjs --check && node scripts/check-public-boundary.mjs && eslint . --ignore-pattern dist --ignore-pattern .next && next build --webpack && node --test tests/*.test.mjs",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.62.5",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.6.4",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.1.2",
    "@vitejs/plugin-rsc": "0.5.35",
    "drizzle-kit": "0.31.11",
    "eslint": "10.12.0",
    "eslint-config-next": "16.3.8",
    "react-server-dom-webpack": "19.3.0",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vinext": "1.0.1",
    "vite": "8.3.2",
    "wrangler": "4.147.0"
  },
  "type": "module"
}
